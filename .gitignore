# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
*.js.map

# Stray compiled output from ad-hoc tsc/node runs against backend/test — that dir is TS-only.
backend/test/**/*.js

# Env files — never commit real secrets, .env.example files are the documented template
!.env.example

# Backend local media storage (dev only)
backend/uploads/*
!backend/uploads/.gitkeep

# Editor directories and files
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
config.bat
